cat > .env.example <<'EOF'
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/arkyl_ventures?schema=public"

# Generate a long random value before deployment
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Initial administrator bootstrap. Use a unique password and remove these
# variables after creating the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE-THIS-IMMEDIATELY"

# Object storage / email / payment integrations will be configured in later phases.
