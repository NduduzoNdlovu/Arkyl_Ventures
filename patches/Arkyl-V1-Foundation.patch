+.background-glow { position: absolute; width: 360px; height: 360px; border-radius: 50%; filter: blur(90px); opacity: .12; }
+.background-glow-one { top: 320px; left: -180px; background: #50f5bd; }
+.background-glow-two { top: 950px; right: -200px; background: #287b86; }
