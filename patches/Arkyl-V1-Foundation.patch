+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 110px; }
+body { margin: 0; padding: 0; background: var(--color-background-deep); color: var(--color-text); font-family: var(--font-body); -webkit-font-smoothing: antialiased; }
