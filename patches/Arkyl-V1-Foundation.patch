+.background-star-one { top: 260px; left: 8%; font-size: 26px; }
+.background-star-two { top: 680px; right: 9%; font-size: 44px; }
+
+.site-header { position: fixed; inset: 0 0 auto; z-index: 50; height: var(--header-height); display: flex; align-items: center; border-bottom: 1px solid rgba(164,184,190,.07); background: rgba(7,20,26,.78); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
+.header-inner { width: min(calc(100% - 56px), 1380px); margin-inline: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
